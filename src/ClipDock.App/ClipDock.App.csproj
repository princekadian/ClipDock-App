<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ClipDock</AssemblyName>
    <Product>ClipDock</Product>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipDock.Core\ClipDock.Core.csproj" />
    <ProjectReference Include="..\ClipDock.Infrastructure\ClipDock.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\app-icon.png" />
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

</Project>

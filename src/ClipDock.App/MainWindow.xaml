<Window x:Class="ClipDock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d" Title="ClipDock" Icon="/Assets/app-icon.png" Width="1060" Height="720" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0E0F11" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="3" ClipToBounds="True" Background="#09090A" Margin="0,0,8,0">
                        <Image Source="/Assets/app-icon.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="ClipDock" Foreground="#F2F3F5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" AutomationProperties.Name="Minimize">
                        <Border Width="10" Height="1" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" SnapsToDevicePixels="True" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" AutomationProperties.Name="Maximize or restore">
                        <Grid Width="12" Height="12" SnapsToDevicePixels="True">
                            <Border x:Name="MaximizeBox" Width="10" Height="10" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1" />
                            <Grid x:Name="RestoreBoxes" Visibility="Collapsed">
                                <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1" Data="M 1,3 L 1,11 L 9,11 L 9,3 Z M 3,3 L 3,1 L 11,1 L 11,9 L 9,9" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" AutomationProperties.Name="Close">
                        <Path Width="11" Height="11" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" Data="M 0,0 L 10,10 M 10,0 L 0,10" SnapsToDevicePixels="True" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" ClipToBounds="True" Background="{DynamicResource WindowBrush}" IsHitTestVisible="False">
            <Image x:Name="WallpaperImage" Margin="-22" Stretch="UniformToFill"
                   Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect><BlurEffect Radius="18" RenderingBias="Performance" /></Image.Effect>
            </Image>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource WallpaperScrimBrush}" IsHitTestVisible="False" />

        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="18,18,12,12" Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="5" Background="#09090A" Margin="0,0,9,0" ClipToBounds="True">
                        <Image Source="/Assets/app-icon.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="ClipDock" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Content="Downloads" Command="{Binding NavigateCommand}" CommandParameter="Downloads">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Downloads"><Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="Queue" Command="{Binding NavigateCommand}" CommandParameter="Queue">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Queue"><Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="History" Command="{Binding NavigateCommand}" CommandParameter="History">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="History"><Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Settings"><Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Local. Private. Lightweight." Foreground="#9DA4AD" FontSize="11" Margin="20,14,12,20" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="32,25,34,30">
            <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Downloads}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="Download video" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Inspect the available streams before anything is downloaded." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" ToolTip="YouTube watch, Shorts, or youtu.be link" AutomationProperties.Name="YouTube video URL" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Analyze" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButton}" MinWidth="92" />
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{DynamicResource ErrorSurfaceBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="4" Padding="12,9" Margin="0,0,0,14"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource TextVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" />
                        <Grid Visibility="{Binding HasVideo, Converter={StaticResource BooleanVisibility}}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,18">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="144" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="128" Height="72" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="3" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VideoTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding VideoChannel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding VideoDuration}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Download quality" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer}" AutomationProperties.Name="Output format" />
                            </Grid>
                            <StackPanel Grid.Row="2">
                                <ListBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ForwardMouseWheel">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" /></Trigger></Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><Grid Height="46" Margin="13,0"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Download" Command="{Binding DownloadCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="124" Margin="0,16,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Queue}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,20"><TextBlock Text="Download queue" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Active and pending transfers" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
                <TextBlock Grid.Row="1" Text="Your queue is empty. Analyze a video to start a download." Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding QueueItems.Count, Converter={StaticResource CountVisibility}, ConverterParameter=Inverse}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding QueueItems.Count, Converter={StaticResource CountVisibility}}">
                    <ItemsControl ItemsSource="{Binding QueueItems}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="68" Height="40" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="3" ClipToBounds="True"><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" /></Border>
                                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                    <DockPanel><TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" /><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></DockPanel>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,8" />
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                                    <DockPanel Margin="0,6,0,0"><TextBlock Text="{Binding ProgressLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding TransferLabel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" /></DockPanel>
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource TextVisibility}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Open folder" Command="{Binding DataContext.OpenQueueFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0"
                                            Visibility="{Binding CanOpenFolder, Converter={StaticResource BooleanVisibility}}" />
                                    <Button Content="Pause" Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0" />
                                    <Button Content="Resume" Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0" />
                                    <Button Content="Cancel" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibility}, ConverterParameter=History}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,20"><TextBlock Text="History" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Completed downloads stored on this device" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
                <TextBlock Grid.Row="1" Text="Completed downloads will appear here." Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HistoryItems.Count, Converter={StaticResource CountVisibility}, ConverterParameter=Inverse}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HistoryItems.Count, Converter={StaticResource CountVisibility}}">
                    <ItemsControl ItemsSource="{Binding HistoryItems}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" /><TextBlock Text="{Binding CompletedLabel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Open" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0" />
                                <Button Content="Folder" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0" />
                                <Button Content="Copy path" Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0" />
                                <Button Content="Remove" Command="{Binding DataContext.RemoveHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Settings}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18"><TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Application, download, and browser integration preferences" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Downloads" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Download location" Margin="0,0,0,5" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Settings.DownloadDirectory}" IsReadOnly="True" Margin="0,0,8,0" /><Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}" /></Grid>
                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="220" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Default quality" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding DefaultQualityOptions}" SelectedItem="{Binding Settings.DefaultHeight}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Default format" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding Containers}" SelectedItem="{Binding Settings.DefaultContainer}" /></StackPanel>
                        <StackPanel Grid.Column="2" Margin="14,0,0,0"><TextBlock Text="Concurrent downloads" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding ConcurrentOptions}" SelectedItem="{Binding Settings.MaximumConcurrentDownloads}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="Filename template" Margin="0,14,0,5" /><TextBox Text="{Binding Settings.FilenameTemplate, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="Use %(title)s and %(ext)s. Paths are not allowed." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
                    <Separator Margin="0,22,0,18" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="General" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox Content="Show download notifications" IsChecked="{Binding Settings.ShowNotifications}" /><CheckBox Content="Confirm before cancelling" IsChecked="{Binding Settings.ConfirmBeforeCancelling}" />
                    <TextBlock Text="Background wallpaper" Margin="0,13,0,5" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding WallpaperLabel, Mode=OneWay}" IsReadOnly="True" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Choose image" Command="{Binding ChooseWallpaperCommand}" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveWallpaperCommand}"
                                Visibility="{Binding HasWallpaper, Converter={StaticResource BooleanVisibility}}" />
                    </Grid>
                    <TextBlock Text="The image is fitted to the workspace and blurred behind a contrast layer." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" />
                    <Separator Margin="0,22,0,18" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="Browser integration" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5" /><TextBlock Text="Local bridge running" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="Pairing token" Margin="0,0,0,5" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Settings.BridgeToken}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,0,8,0" /><Button Grid.Column="1" Content="Copy" Command="{Binding CopyTokenCommand}" /></Grid>
                    <TextBlock Text="Paste this token into the ClipDock extension settings. It authorizes local download requests." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" />
                    <Separator Margin="0,22,0,18" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="Download engines" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="ClipDock uses these local tools for video extraction and stream merging." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel>
                            <Grid MinHeight="58" Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="yt-dlp" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding YtDlpStatus}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                <Button Grid.Column="2" Content="{Binding YtDlpActionLabel}" Command="{Binding UpdateEngineCommand}" VerticalAlignment="Center" MinWidth="132" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid MinHeight="58" Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="FFmpeg" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding FfmpegStatus}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                <Button Grid.Column="2" Content="Download and install" Command="{Binding InstallFfmpegCommand}" VerticalAlignment="Center" MinWidth="132"
                                        Visibility="{Binding IsFfmpegInstalled, Converter={StaticResource BooleanVisibility}, ConverterParameter=Inverse}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button Content="Open logs" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="120" Margin="0,22,0,16" />
                </StackPanel></ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
